# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_NAME=Event Registration

# Local PostgreSQL
DB_NAME=im2_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# Supabase instead: use the values from Project Settings > Database
# DB_HOST=aws-0-xx.pooler.supabase.com
# DB_USER=postgres.yourprojectref
# DB_PORT=5432
# DB_SSLMODE=require

# Demo accounts (python manage.py create_demo_users)
DEMO_ADMIN_PASSWORD=choose-a-password
DEMO_MEMBER_PASSWORD=choose-a-password
DEMO_OFFICER_PASSWORD=choose-a-password
DEMO_STUDENT_PASSWORD=choose-a-password
